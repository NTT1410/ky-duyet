{
  "name": "ky-duyet-desktop",
  "version": "1.0.0",
  "description": "Phần mềm Ký duyệt Doanh nghiệp & Ký số USB Token",
  "main": "dist/main.js",
  "author": "Doanh Nghiệp",
  "scripts": {
    "build:ts": "tsc",
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.company.kyduyet",
    "productName": "KyDuyet Enterprise",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ký Duyệt Doanh Nghiệp"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
